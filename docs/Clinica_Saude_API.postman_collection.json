    {
      "name": "Profissionais",
      "item": [
        {
          "name": "Listar Todos os Profissionais",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code é 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Retorna um array de profissionais\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Valida a estrutura do primeiro profissional\", function () {",
                  "    var item = pm.response.json()[0];",
                  "    pm.expect(item).to.have.property('id');",
                  "    pm.expect(item).to.have.property('nome');",
                  "    pm.expect(item).to.have.property('especialidade');",
                  "    pm.expect(item).to.have.property('horarios_disponiveis');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/profissionais",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "profissionais"]
            }
          }
        },
        {
          "name": "Filtrar por Especialidade (Cardiologia)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code é 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Todos os resultados pertencem à Cardiologia\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    jsonData.forEach(function(p) {",
                  "        pm.expect(p.especialidade.toLowerCase()).to.eql('cardiologia');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/profissionais?especialidade=Cardiologia",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "profissionais"],
              "query": [
                {
                  "key": "especialidade",
                  "value": "Cardiologia"
                }
              ]
            }
          }
        },
        {
